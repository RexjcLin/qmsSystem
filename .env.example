DJANGO_SECRET_KEY=replace-me-for-local-development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use sqlite for zero-config local startup, or set mysql for qms_db.
DB_ENGINE=mysql
DB_NAME=qms_db
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Local-only seed user passwords. Replace before sharing the environment.
QMS_ADMIN_PASSWORD=ChangeMeAdmin123!
QMS_MANAGER_PASSWORD=ChangeMeManager123!
QMS_INSPECTOR_PASSWORD=ChangeMeInspector123!
